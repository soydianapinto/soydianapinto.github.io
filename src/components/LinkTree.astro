---
import FollowerBadge from './FollowerBadge.astro';
import SocialLinks from './SocialLinks.astro';

const links = [
	{
		label: 'Colaboraciones y campañas',
		description: 'Contacto para marcas',
		href: 'mailto:depa.apolinar@gmail.com?subject=Colaboraci%C3%B3n%20con%20Diana%20Pinto',
	},
	{
		label: 'AWS Community Builder',
		description: 'Perfil de la comunidad AWS',
		href: 'https://builder.aws.com/community/@soydianapinto/',
	},
	{
		label: 'Mentorías / Tutorías',
		description: 'Acompañamiento en tecnología',
		href: 'https://www.paypal.com/ncp/payment/S9PN3T8F3NJVJ/',
	},
	{
		label: 'Next Review',
		description: 'Herramienta de código abierto',
		href: 'https://github.com/soydianapinto/nextreview/',
	},
	// TODO: Restore the Cold Brew link.
];
---

<main class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#f8f8f8] px-4 py-8 text-[#171717] sm:px-8 sm:py-12">
	<div class="pointer-events-none absolute -left-28 -top-28 size-72 rounded-full bg-black/10 blur-3xl" aria-hidden="true"></div>
	<div class="pointer-events-none absolute -bottom-32 -right-24 size-80 rounded-full bg-black/15 blur-3xl" aria-hidden="true"></div>
	<section
		class="relative w-full max-w-lg overflow-hidden rounded-3xl border border-black/20 bg-gradient-to-b from-black via-[#666666] to-white p-5 shadow-xl shadow-black/25 transition-all duration-500 ease-out hover:shadow-2xl hover:shadow-black/30 sm:p-8"
		aria-labelledby="profile-name"
	>
		<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.9),transparent_38%),linear-gradient(180deg,rgba(0,0,0,0.1),transparent_55%,rgba(255,255,255,0.2))]" aria-hidden="true"></div>
		<div class="relative">
		<header class="mb-8 text-center">
			<img
				class="mx-auto mb-5 size-24 rounded-full border border-white/90 object-cover shadow-[0_10px_30px_rgba(0,0,0,0.18)]"
				src="/profile.jpg"
				alt="Foto de perfil de Diana Pinto"
				width="96"
				height="96"
			/>
			<h1 id="profile-name" class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
				Diana Pinto
			</h1>
			<p class="mt-2 font-mono text-sm text-white/80">@soydianapinto</p>
			<p class="mt-4 text-sm text-white/90 sm:text-base">Ingeniera Full-Stack &amp; Creadora de Contenido Tech</p>
			<!-- TODO: Restore FollowerBadge once the follower API integration is complete. -->
			<!-- <FollowerBadge /> -->
		</header>

		<SocialLinks />

		<nav aria-label="Enlaces de Diana Pinto">
			<ul class="space-y-3">
				{links.map((link) => (
					<li>
						<a
							class="group flex min-h-16 items-center justify-between rounded-full border border-white/65 bg-white/30 px-5 py-3.5 text-[#171717] shadow-[0_8px_24px_rgba(0,0,0,0.14)] backdrop-blur-md transition-all duration-500 ease-out hover:-translate-y-1 hover:scale-[1.01] hover:border-white/90 hover:bg-white/50 hover:shadow-[0_14px_30px_rgba(0,0,0,0.22)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
							href={link.href}
							target="_blank"
							rel="noreferrer"
						>
							<span>
								<span class="block font-medium text-[#171717] transition-colors group-hover:text-black">
									{link.label}
								</span>
								<span class="mt-1 block text-xs text-[#363636]">{link.description}</span>
							</span>
							<span class="ml-4 font-mono text-lg text-[#4a4a4a] transition-all duration-500 group-hover:translate-x-1 group-hover:text-black" aria-hidden="true">
								&rarr;
							</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
		</div>
	</section>
</main>
