---
import FollowerBadge from './FollowerBadge.astro';
import SocialLinks from './SocialLinks.astro';
import { externalLinkAttrs, profile, profileLinks } from '../data/site';
---

<main class="site-shell">
	<div class="pointer-events-none absolute -left-28 -top-28 size-72 rounded-full bg-black/10 blur-3xl" aria-hidden="true"></div>
	<section class="profile-card" aria-labelledby="profile-name">
		<div class="profile-overlay" aria-hidden="true"></div>
		<div class="relative">
			<header class="mb-8 text-center">
				<img
					class="profile-avatar"
					src="/profile.jpg"
					alt="Foto de perfil de Diana Pinto"
					width="96"
					height="96"
				/>
				<h1 id="profile-name" class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
					{profile.name}
				</h1>
				<p class="mt-4 text-sm text-white/90 sm:text-base">{profile.headline}</p>
				<div class="mt-5 flex items-center justify-center gap-4">
					<p class="font-mono text-sm text-white/80">{profile.handle}</p>
					<FollowerBadge />
				</div>
			</header>

			<SocialLinks />

			<nav aria-label="Enlaces de Diana Pinto">
				<ul class="space-y-3">
					{profileLinks.map((link) => (
						<li>
							{link.sectionLabel && <p class="section-label">{link.sectionLabel}</p>}
							<a class="group link-button" href={link.href} {...externalLinkAttrs}>
								<span class="min-w-0">
									<span class="block font-medium text-ink transition-colors group-hover:text-black">
										{link.label}
									</span>
									{link.description && (
										<span class="mt-1 block text-xs text-muted">{link.description}</span>
									)}
								</span>
								<span class="ml-4 font-mono text-lg text-subtle transition-all duration-500 group-hover:translate-x-1 group-hover:text-black" aria-hidden="true">&rarr;</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
	</section>
</main>
