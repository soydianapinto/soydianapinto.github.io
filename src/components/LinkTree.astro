---
import FollowerBadge from './FollowerBadge.astro';
import SocialLinks from './SocialLinks.astro';

const links = [
	{
		label: 'Colaboraciones y campañas',
		description: 'Contacto para marcas',
		href: 'mailto:depa.apolinar@gmail.com?subject=Colaboraci%C3%B3n%20con%20Diana%20Pinto',
	},
	{
		label: 'AWS Community Builder',
		description: 'Perfil de la comunidad AWS',
		href: 'https://builder.aws.com/community/@soydianapinto/',
	},
	{
		label: 'Mentorías / Tutorías',
		description: 'Acompañamiento en tecnología',
		href: 'https://www.paypal.com/ncp/payment/S9PN3T8F3NJVJ/',
	},
	{
		label: 'Next Review',
		description: 'Herramienta de código abierto',
		href: 'https://github.com/soydianapinto/nextreview/',
	},
	// TODO: Restore the Cold Brew link once the business is more established.
];
---

<main class="flex min-h-screen items-center justify-center bg-[#a89582] px-4 py-8 text-[#242321] sm:px-8 sm:py-12">
	<section
		class="w-full max-w-lg rounded-3xl border border-[#b9a897]/70 bg-[#d8d0c3]/65 p-5 shadow-xl shadow-[#6f665a]/25 backdrop-blur-xl sm:p-8"
		aria-labelledby="profile-name"
	>
		<header class="mb-8 text-center">
			<img
				class="mx-auto mb-5 size-24 rounded-full border border-[#d6d0c6] object-cover shadow-[0_0_30px_rgba(111,102,90,0.16)]"
				src="/profile.jpg"
				alt="Foto de perfil de Diana Pinto"
				width="96"
				height="96"
			/>
			<h1 id="profile-name" class="text-2xl font-bold tracking-tight text-[#242321] sm:text-3xl">
				Diana Pinto
			</h1>
			<p class="mt-2 font-mono text-sm text-[#756f67]">@soydianapinto</p>
			<p class="mt-4 text-sm text-[#5a4638] sm:text-base">Ingeniera Full-Stack &amp; Creadora de Contenido Tech</p>
			<!-- TODO: Restore FollowerBadge once the follower API integration is complete. -->
			<!-- <FollowerBadge /> -->
		</header>

		<SocialLinks />

		<nav aria-label="Enlaces de Diana Pinto">
			<ul class="space-y-3">
				{links.map((link) => (
					<li>
						<a
							class="group flex min-h-16 items-center justify-between rounded-full border border-white/65 bg-white/45 px-5 py-3.5 text-[#292826] shadow-sm backdrop-blur-md transition duration-200 hover:-translate-y-0.5 hover:border-white/90 hover:bg-white/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4f7059]"
							href={link.href}
							target="_blank"
							rel="noreferrer"
						>
							<span>
								<span class="block font-medium text-[#292826] transition-colors group-hover:text-[#1f2d23]">
									{link.label}
								</span>
								<span class="mt-1 block text-xs text-[#625d56]">{link.description}</span>
							</span>
							<span class="ml-4 font-mono text-lg text-[#756f67] transition group-hover:translate-x-1 group-hover:text-[#4f7059]" aria-hidden="true">
								&rarr;
							</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</section>
</main>
