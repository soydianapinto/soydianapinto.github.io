---
const projects = [
	{
		name: 'Next Review',
		description: 'Herramienta open-source para gestión de pull requests.',
		href: 'https://github.com/soydianapinto/nextreview/',
		badges: ['Browser Extension', 'Developer Tools'],
	},
	{
		name: 'Personal Site (this page)',
		description: 'Sitio personal construido con Astro y Tailwind CSS.',
		href: 'https://github.com/soydianapinto/soydianapinto.github.io',
		badges: ['Astro', 'Tailwind CSS', 'GitHub Pages'],
	},
];
---

<section
	class="project-section"
	aria-labelledby="projects-title"
>
	<h2 id="projects-title" class="mb-4 text-center text-lg text-[#363636]">Proyectos</h2>
	<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
		{projects.map((project) => (
			<a
				class="group project-card"
				href={project.href}
				target="_blank"
				rel="noreferrer"
			>
				<div class="flex min-w-0 items-start justify-between gap-3">
					<h3 class="min-w-0 break-words text-base text-[#171717]">{project.name}</h3>
					<span class="shrink-0 font-mono text-lg text-[#4a4a4a] transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
				</div>
				<p class="mt-3 text-sm leading-5 text-[#4a4a4a]">{project.description}</p>
				<ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologías de ${project.name}`}>
					{project.badges.map((badge) => (
						<li class="rounded-full border border-black/15 px-3 py-1 font-mono text-[10px] text-[#363636]">
							{badge}
						</li>
					))}
				</ul>
			</a>
		))}
	</div>
</section>
