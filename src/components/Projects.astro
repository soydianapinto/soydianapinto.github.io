---
import ContentSection from './ContentSection.astro';
import { externalLinkAttrs, projects } from '../data/site';
---

<ContentSection labelledBy="projects-title">
	<h2 id="projects-title" class="section-title mb-4">Proyectos</h2>
	<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
		{projects.map((project) => (
			<a class="group project-card" href={project.href} {...externalLinkAttrs}>
				<div class="flex min-w-0 items-start justify-between gap-3">
					<h3 class="min-w-0 break-words text-base text-ink">{project.name}</h3>
					<span class="shrink-0 font-mono text-lg text-subtle transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
				</div>
				<p class="mt-3 text-sm leading-5 text-subtle">{project.description}</p>
				<ul class="mt-5 flex flex-wrap gap-2" aria-label={`Tecnologías de ${project.name}`}>
					{project.badges.map((badge) => (
						<li class="rounded-full border border-black/15 px-3 py-1 font-mono text-[10px] text-muted">
							{badge}
						</li>
					))}
				</ul>
			</a>
		))}
	</div>
</ContentSection>
