---
const playlistUri = 'spotify:playlist:3KaA1cmL17vYQbxIBZ31Se';
const playlistUrl = 'https://open.spotify.com/playlist/3KaA1cmL17vYQbxIBZ31Se';
---

<section class="playlist-section content-section" aria-labelledby="playlist-title">
	<div class="content-column">
		<h2 id="playlist-title" class="section-title mb-2">Música</h2>
		<p class="mb-4 text-center text-sm leading-5 text-subtle">La música que uso en mis videos de lipsync</p>
		<div id="spotify-playlist"></div>
		<p class="mt-4 text-center text-sm">
			<a
				class="text-muted underline decoration-black/20 underline-offset-4"
				href={playlistUrl}
				target="_blank"
				rel="noreferrer"
			>
				Abrir en Spotify
			</a>
		</p>
	</div>
</section>

<script is:inline define:vars={{ playlistUri }}>
	window.onSpotifyIframeApiReady = (IFrameAPI) => {
		const element = document.getElementById('spotify-playlist');

		IFrameAPI.createController(
			element,
			{
				uri: playlistUri,
				width: '100%',
				height: 352,
			},
			(controller) => {
				const iframe = document.querySelector('.playlist-section iframe');
				if (iframe) iframe.loading = 'eager';

				controller.addListener('ready', () => {
					controller.play();
				});
			},
		);
	};
</script>
<script is:inline async src="https://open.spotify.com/embed/iframe-api/v1"></script>
