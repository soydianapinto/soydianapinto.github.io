---
import ContentSection from './ContentSection.astro';
import { externalLinkAttrs, spotifyPlaylist } from '../data/site';
---

<ContentSection labelledBy="playlist-title" class="playlist-section">
	<h2 id="playlist-title" class="section-title mb-2">Música</h2>
	<p class="mb-4 text-center text-sm leading-6">
		<a
			class="text-subtle underline decoration-current/40 underline-offset-4 transition-colors hover:text-ink"
			href={spotifyPlaylist.url}
			{...externalLinkAttrs}
		>
			Escucha en Spotify la música que uso en mis videos de lipsync
		</a>
	</p>
	<div id="spotify-playlist"></div>
</ContentSection>

<script is:inline define:vars={{ playlistUri: spotifyPlaylist.uri }}>
	window.onSpotifyIframeApiReady = (IFrameAPI) => {
		const element = document.getElementById('spotify-playlist');

		IFrameAPI.createController(
			element,
			{
				uri: playlistUri,
				width: '100%',
				height: 352,
			},
			// Spotify mounts the playlist in this callback. Leave playback to the listener.
			() => {},
		);
	};
</script>
<script is:inline async src="https://open.spotify.com/embed/iframe-api/v1"></script>
