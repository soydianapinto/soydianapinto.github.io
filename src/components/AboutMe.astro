---
import ContentSection from './ContentSection.astro';
import { outbound, profile } from '../data/site';
---

<ContentSection labelledBy="about-me-title">
	<div class="terminal-card">
		<div class="terminal-header" aria-hidden="true">
			<span class="size-3 rounded-full bg-[#ff5f57]"></span>
			<span class="size-3 rounded-full bg-[#febc2e]"></span>
			<span class="size-3 rounded-full bg-[#28c840]"></span>
			<span class="ml-2 font-mono text-sm text-white/60">sobre-mi.json</span>
		</div>
		<div class="terminal-code">
			<h2 id="about-me-title" class="sr-only">Sobre Diana Pinto</h2>
			<pre class="font-mono text-sm leading-7 break-words whitespace-pre-wrap text-white sm:text-base"><code><span class="text-white/45">&#123;</span>
  <span class="text-white/70">"name"</span><span class="text-white/45">: </span><span class="text-white">"{profile.name}"</span><span class="text-white/45">,</span>
  <span class="text-white/70">"role"</span><span class="text-white/45">: </span><span class="text-white">"{profile.headline}"</span><span class="text-white/45">,</span>
  <span class="text-white/70">"stack"</span><span class="text-white/45">: [</span>
    <span class="text-white">"Java"</span><span class="text-white/45">, </span><span class="text-white">"Spring Boot"</span><span class="text-white/45">,</span>
    <span class="text-white">"ReactJS"</span><span class="text-white/45">, </span><span class="text-white">"AWS"</span><span class="text-white/45">,</span>
    <span class="text-white">"Azure"</span>
  <span class="text-white/45">],</span>
  <span class="text-white/70">"current_focus"</span><span class="text-white/45">: </span><span class="text-white">"Doctorado en Ciencia y Tecnología"</span><span class="text-white/45">,</span>
  <span class="text-white/70">"status"</span><span class="text-white/45">: </span><span class="text-white">"Construyendo tecnología con propósito"</span><span class="text-white/45">,</span>
  <span class="text-white/70">"pet"</span><span class="text-white/45">: </span><span class="text-white">"Tinky Cat"</span><span class="text-white/45">,</span>
  <span class="text-white/70">"mission"</span><span class="text-white/45">: </span><span class="text-white">"Sobrevivir a la IA"</span><span class="text-white/45">,</span>
  <span class="text-white/70">"reading"</span><span class="text-white/45">: </span><a class="text-white underline decoration-white/30 underline-offset-4 transition-colors hover:text-white/70" href={outbound.fable} target="_blank" rel="noopener noreferrer">"Mi perfíl de Fable"</a>
<span class="text-white/45">&#125;</span></code></pre>
		</div>
	</div>
</ContentSection>
