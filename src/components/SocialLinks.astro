---
const socialLinks = [
	{
		label: 'Instagram',
		src: '/icons/instagram.svg',
		href: 'https://www.instagram.com/soydianapinto/',
	},
	{
		label: 'Facebook',
		src: '/icons/facebook.svg',
		href: 'https://www.facebook.com/soydianapinto/',
	},
	{
		label: 'LinkedIn',
		src: '/linkedin.svg',
		href: 'https://www.linkedin.com/in/soydianapinto/',
	},
	{
		label: 'YouTube',
		src: '/icons/youtube.svg',
		href: 'https://www.youtube.com/channel/UCcCb2sTaPgF4Cq7K17p4N3A',
	},
	{
		label: 'TikTok',
		src: '/icons/tiktok.svg',
		href: 'https://www.tiktok.com/@soydianapinto',
	},
	{
		label: 'GitHub',
		src: '/icons/github.svg',
		href: 'https://github.com/soydianapinto',
	},
];
---

<nav class="social-nav" aria-label="Redes sociales">
	{socialLinks.map((social) => (
		<a
			class="social-link"
			href={social.href}
			target="_blank"
			rel="noreferrer"
			aria-label={social.label}
		>
			<img
				class="size-5"
				src={social.src}
				alt=""
				width="20"
				height="20"
			/>
		</a>
	))}
</nav>
