---
const socialLinks = [
	{
		label: 'Instagram',
		icon: 'instagram',
		href: 'https://www.instagram.com/soydianapinto/',
	},
	{
		label: 'Facebook',
		icon: 'facebook',
		href: 'https://www.facebook.com/soydianapinto/',
	},
	{
		label: 'LinkedIn',
		src: '/linkedin.svg',
		href: 'https://www.linkedin.com/in/soydianapinto/',
	},
	{
		label: 'YouTube',
		icon: 'youtube',
		href: 'https://www.youtube.com/channel/UCcCb2sTaPgF4Cq7K17p4N3A',
	},
	{
		label: 'TikTok',
		icon: 'tiktok',
		href: 'https://www.tiktok.com/@soydianapinto',
	},
	{
		label: 'GitHub',
		icon: 'github',
		href: 'https://github.com/soydianapinto',
	},
];
---

<nav class="social-nav" aria-label="Redes sociales">
	{socialLinks.map((social) => (
		<a
			class="social-link"
			href={social.href}
			target="_blank"
			rel="noreferrer"
			aria-label={social.label}
		>
			<img
				class="size-5"
				src={social.src ?? `https://cdn.simpleicons.org/${social.icon}/FFFFFF`}
				alt=""
				width="20"
				height="20"
				loading="lazy"
			/>
		</a>
	))}
</nav>
