---
import { externalLinkAttrs, socialLinks } from '../data/site';
---

<nav class="social-nav" aria-label="Redes sociales">
	{socialLinks.map((social) => (
		<a class="social-link" href={social.href} {...externalLinkAttrs} aria-label={social.label}>
			<img class="size-5" src={social.src} alt="" width="20" height="20" />
		</a>
	))}
</nav>
