---
const totalFollowers = 60174;
// All 7 Social Media, last manually updated: October 12, 2026.
const formattedTotal = `${(totalFollowers / 1000).toFixed(1)}k`;
---

<p
	class="mx-auto mt-5 inline-flex items-center gap-2 font-mono text-sm tracking-wide text-white/75"
	aria-label={`${formattedTotal} seguidores`}
>
	<span><strong class="font-semibold text-white">{formattedTotal}</strong> seguidores</span>
</p>
