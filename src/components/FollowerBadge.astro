---
type FollowerResponse = {
	followers?: number;
	followers_count?: number;
	data?: {
		followers?: number;
		public_metrics?: {
			followers_count?: number;
		};
	};
};

type Network = {
	name: string;
	token: string | undefined;
	endpoint: string;
};

// TODO: Replace placeholder IDs and endpoints with each platform's
// production API contract before enabling the scheduled refresh.
const networks: Network[] = [
	{
		name: 'Instagram',
		token: import.meta.env.INSTAGRAM_TOKEN,
		// TODO: Set the Instagram Business/Creator account ID.
		endpoint: 'https://graph.facebook.com/v21.0/{tu_ig_user_id}?fields=followers_count&access_token=${import.meta.env.INSTAGRAM_TOKEN}',
	},
	{
		name: 'Facebook',
		token: import.meta.env.FACEBOOK_TOKEN,
		// TODO: Set the Facebook Page ID and confirm the required permissions.
		endpoint: 'https://graph.facebook.com/v21.0/{tu_page_id}?fields=followers_count&access_token=${import.meta.env.FACEBOOK_TOKEN}',
	},
	{
		name: 'Threads',
		token: import.meta.env.THREADS_TOKEN,
		// TODO: Confirm the Threads endpoint and account permissions.
		endpoint: 'https://graph.threads.net/v1.0/me?fields=followers_count&access_token=${import.meta.env.THREADS_TOKEN}',
	},
	{
		name: 'X',
		token: import.meta.env.X_TOKEN,
		// TODO: Add the X user ID or resolve it before requesting metrics.
		endpoint: 'https://api.twitter.com/2/users/by/username/soydianapinto?user.fields=public_metrics',
	},
	{
		name: 'LinkedIn',
		token: import.meta.env.LINKEDIN_PROXY_TOKEN,
		// TODO: Verify the provider, endpoint, and permissions for this profile.
		endpoint: 'https://nubela.co/proxycurl/api/linkedin/person/profile-follower-count?linkedin_profile_url=https://www.linkedin.com/in/soydianapinto/',
	},
	{
		name: 'YouTube',
		token: import.meta.env.YOUTUBE_TOKEN,
		// TODO: Set the YouTube channel ID.
		endpoint: 'https://youtube.googleapis.com/youtube/v3/channels?part=statistics&id={tu_channel_id}&key=${import.meta.env.YOUTUBE_TOKEN}',
	},
	{
		name: 'TikTok',
		token: import.meta.env.TIKTOK_TOKEN,
		// TODO: Confirm the TikTok endpoint and approved app scope.
		endpoint: 'https://open.tiktokapis.com/v2/user/info/?fields=follower_count',
	},
];

const fetchFollowerCount = async (network: Network): Promise<number> => {
	if (!network.token) {
		throw new Error(`${network.name} token is not configured`);
	}

	const response = await fetch(network.endpoint, {
		headers: {
			Authorization: `Bearer ${network.token}`,
			Accept: 'application/json',
		},
	});

	if (!response.ok) {
		throw new Error(`${network.name} API returned ${response.status}`);
	}

	const payload = (await response.json()) as FollowerResponse;
	// TODO: Replace this fallback chain with a platform-specific response
	// parser once the seven production API contracts are confirmed.
	const count =
		payload.followers ??
		payload.followers_count ??
		payload.data?.followers ??
		payload.data?.public_metrics?.followers_count;

	if (typeof count !== 'number' || !Number.isFinite(count) || count < 0) {
		throw new Error(`${network.name} API returned an invalid follower count`);
	}

	return count;
};

// TODO: Decide whether partial totals should be shown or replaced with an
// unavailable state when one or more platforms fail.
const results = await Promise.allSettled(networks.map(fetchFollowerCount));
const totalFollowers = results.reduce(
	(total, result) => (result.status === 'fulfilled' ? total + result.value : total),
	0,
);
const formattedTotal = totalFollowers.toLocaleString('en-US');
---

<p
	class="mx-auto mt-5 inline-flex items-center gap-2 font-mono text-sm tracking-wide text-emerald-400"
	aria-label={`${formattedTotal} followers`}
>
	<span><strong class="font-semibold">{formattedTotal}</strong> seguidores</span>
</p>
