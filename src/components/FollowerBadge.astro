---
import { formatFollowers, profile } from '../data/site';

const formattedTotal = formatFollowers(profile.followers);
---

<p class="inline-flex items-center font-mono text-sm tracking-wide text-white/75" aria-label={`${formattedTotal} seguidores`}>
	<span><strong class="font-semibold text-white">{formattedTotal}</strong> seguidores</span>
</p>
